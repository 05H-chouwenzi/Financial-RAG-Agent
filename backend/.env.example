# ===== 数据目录（默认项目内 data/） =====
# DATA_DIR=

# ===== 巨潮资讯网（默认即可，一般不用改） =====
# CNINFO_BASE=http://www.cninfo.com.cn
# CNINFO_QUERY_URL=http://www.cninfo.com.cn/new/hisAnnouncement/query
# CNINFO_STATIC_BASE=http://static.cninfo.com.cn

# ===== 下载参数 =====
DOWNLOAD_TIMEOUT=30
DOWNLOAD_RETRIES=3
REQUEST_DELAY=0.8

# ===== Embedding =====
# dashscope（推荐，需 API Key）/ bge（本地模型）/ hash（占位演示）
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_DIM=1024

# ===== 重排 =====
RERANK_ENABLED=true
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_BACKEND=auto        # auto | bge | lexical（强制词法可加速批量评估）

# ===== 检索锚定 =====
# FINANCIAL_BOOST=2.0        # 指标表/股东信息锚定 pre-rerank 加权
# FINANCIAL_ANCHOR_BONUS=0.10  # 指标表核心块在重排阶段的加分

# ===== LLM（OpenAI 兼容，默认阿里云 Dashscope） =====
DASHSCOPE_API_KEY=sk-你的key
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# ===== 切块 =====
# CHUNK_SIZE=600
# CHUNK_OVERLAP=80
# MAX_TABLE_ROWS=30

# ===== 检索 =====
# RETRIEVAL_TOP_K=10
# RETRIEVAL_FINAL_K=5
# FUSION_W_DENSE=0.5
# FUSION_W_SPARSE=0.5
# TABLE_WEIGHT=2.0
# REFUSAL_THRESHOLD=0.10
# STRICT_NUMBERS=true
